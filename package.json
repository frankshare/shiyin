{
  "name": "shiyin",
  "productName": "拾音",
  "version": "0.2.0",
  "description": "全网音乐搜索与播放桌面应用（液态玻璃 · 多主题 · 下载队列 · 歌词点播）",
  "main": "main.js",
  "author": "frankshare",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankshare/shiyin.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.frankshare.shiyin",
    "productName": "拾音",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "downloads.js",
      "package.json",
      "services/**/*",
      "renderer/**/*",
      "assets/icon-v3.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-v3.ico"
    },
    "portable": {
      "artifactName": "拾音-${version}.exe"
    },
    "asar": true,
    "compression": "maximum"
  }
}
